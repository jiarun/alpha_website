# Copy this file to .env.deploy and fill in your GoDaddy/cPanel FTP details.
# Do not commit .env.deploy.

# Use the exact FTP server from GoDaddy/cPanel, not necessarily ftp.yourdomain.com.
# In cPanel this is usually shown under FTP Accounts > Configure FTP Client.
CPANEL_FTP_HOST=your-godaddy-ftp-server.example.com
CPANEL_FTP_USER=your_cpanel_or_ftp_username
CPANEL_FTP_PASSWORD=your_cpanel_or_ftp_password

# Your website is inside this folder in cPanel File Manager.
CPANEL_REMOTE_DIR=public_html/alphary.org

# GoDaddy/cPanel FTP usually uses port 21.
CPANEL_FTP_PORT=21

# Keep true for FTPS. Set false only if your hosting account does not support it.
CPANEL_FTP_SSL=true
